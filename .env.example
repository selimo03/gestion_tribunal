# CONFIGURATION SUPABASE — JusticeTchad
# ─────────────────────────────────────────────────────────────────────
# 1. Allez sur https://supabase.com → votre projet → Settings → API
# 2. Copiez "Project URL" → VITE_SUPABASE_URL
# 3. Copiez "anon public" key → VITE_SUPABASE_ANON_KEY
# 4. Renommez ce fichier en .env (ou définissez ces variables sur Vercel/Netlify)
# ─────────────────────────────────────────────────────────────────────
# NE JAMAIS COMMITTER LE FICHIER .env — il doit être dans .gitignore

# URL de votre projet Supabase (Settings > API > Project URL)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clé publique anon (Settings > API > anon public)
# Cette clé est soumise aux règles RLS — elle est sans danger côté client.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Optionnel ────────────────────────────────────────────────────────────────
# Environnement d'exécution (affiché dans les logs, pas de comportement conditionnel)
# VITE_APP_ENV=development
